<Window x:Class="Passload.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Partage de fichiers" Width="740" Height="620" MinWidth="540" MinHeight="455"
 WindowStartupLocation="CenterScreen" Icon="Assets/Passload.ico" FontFamily="{StaticResource BodyFont}" FontSize="15"
 Foreground="{StaticResource Ink}" Background="White" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" Closing="OnClosing">
 <Grid x:Name="Surface">
  <Grid.RowDefinitions><RowDefinition Height="61"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="26,0">
   <Grid>
    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" VerticalAlignment="Center">
     <RadioButton x:Name="SendNav" Tag="Send" Content="Envoyer" GroupName="Navigation" Style="{StaticResource Nav}" Checked="Navigate"/>
     <RadioButton x:Name="ReceiveNav" Tag="Receive" Content="Recevoir" GroupName="Navigation" Style="{StaticResource Nav}" Checked="Navigate"/>
     <RadioButton x:Name="LinksNav" Tag="Links" GroupName="Navigation" Style="{StaticResource Nav}" Checked="Navigate" AutomationProperties.Name="Liens actifs"><StackPanel Orientation="Horizontal"><AccessText Text="Liens"/><AccessText x:Name="NavCount"/></StackPanel></RadioButton>
    </StackPanel>
    <RadioButton x:Name="NetNav" Tag="Network" GroupName="Navigation" Style="{StaticResource Nav}" Checked="Navigate" ToolTip="Connexion" AutomationProperties.Name="Connexion" HorizontalAlignment="Right" VerticalAlignment="Center">
     <Path Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource Ink}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 1,4 H 10 M 14,4 H 19 M 1,12 H 4 M 8,12 H 19 M 10,1 V 7 M 6,9 V 15"/>
    </RadioButton>
   </Grid>
  </Border>
  <ScrollViewer x:Name="MainScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="24,0">
   <Grid MaxWidth="500" Margin="0,30,0,24">
    <StackPanel x:Name="SendPage">
     <TextBlock Text="Partager des fichiers" Style="{StaticResource Title}"/>
     <Border x:Name="FileCard" AllowDrop="True" PreviewDragOver="DragFilesOver" Drop="DropFiles" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Background="#FCFCFB" Margin="0,22,0,14">
      <StackPanel>
       <Grid x:Name="DropZone" MinHeight="170" Background="Transparent" MouseLeftButtonUp="DropZoneClick" Cursor="Hand">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
         <Path Stroke="{StaticResource Ink}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 12,16 V 2 M 6,8 L 12,2 L 18,8 M 2,16 V 20 Q 2,23 5,23 H 19 Q 22,23 22,20 V 16" HorizontalAlignment="Center" Width="25" Height="25" Stretch="Uniform"/>
         <TextBlock Text="Déposez vos fichiers ici" FontSize="20" FontWeight="SemiBold" Margin="0,11,0,6" HorizontalAlignment="Center"/>
         <Button Content="Parcourir les fichiers" Style="{StaticResource TextAction}" Click="BrowseFiles" HorizontalAlignment="Center"/>
        </StackPanel>
       </Grid>
       <DockPanel x:Name="SelectionHeader" Visibility="Collapsed" Margin="14,10,14,4">
        <Button x:Name="AddMoreButton" DockPanel.Dock="Right" Content="+ Ajouter" Style="{StaticResource TextAction}" Click="BrowseFiles"/>
        <TextBlock x:Name="DraftCount" Style="{StaticResource Hint}"/>
       </DockPanel>
       <ScrollViewer x:Name="DraftScroll" MaxHeight="195" Margin="14,0,14,10" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="DraftRows"/></ScrollViewer>
      </StackPanel>
     </Border>
     <Grid x:Name="OptionsCard" Margin="0,0,0,14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition/><ColumnDefinition Width="101"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="Type de lien" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
      <TextBlock Grid.Column="2" Text="Expiration" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
      <ComboBox x:Name="ConnectionMode" Grid.Row="1" SelectedIndex="0" AutomationProperties.Name="Type de lien">
       <ComboBoxItem Content="Réseau public" ToolTip="Pour partager par Internet"/>
       <ComboBoxItem x:Name="PrivateMode" Content="Réseau privé" ToolTip="Pour partager sur le même réseau"/>
      </ComboBox>
      <Button x:Name="DraftDetailsButton" Grid.Row="1" Grid.Column="1" Content="Nom et description" Click="EditDraftDetails"
       Style="{StaticResource TextAction}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,0"/>
      <ComboBox x:Name="Duration" Grid.Row="1" Grid.Column="2" SelectedIndex="1" AutomationProperties.Name="Durée de validité">
       <ComboBoxItem Content="15 min" Tag="15"/><ComboBoxItem Content="1 heure" Tag="60"/><ComboBoxItem Content="24 heures" Tag="1440"/><ComboBoxItem Content="7 jours" Tag="10080"/>
      </ComboBox>
     </Grid>
     <Button x:Name="CreateButton" Content="Créer le lien" Click="CreateShare" Style="{StaticResource Primary}" IsEnabled="False"/>
     <TextBlock Text="Les liens actifs continuent après la fermeture de la fenêtre." Style="{StaticResource Hint}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
    </StackPanel>
    <StackPanel x:Name="LinksPage" Visibility="Collapsed">
     <DockPanel>
      <Button DockPanel.Dock="Right" Content="Historique" Style="{StaticResource TextAction}" Click="OpenDownloadHistory" VerticalAlignment="Center"/>
      <TextBlock Text="Liens actifs" Style="{StaticResource Title}"/>
     </DockPanel>
     <StackPanel x:Name="LinkCards" Margin="0,20,0,0"/>
    </StackPanel>
    <StackPanel x:Name="ReceivePage" Visibility="Collapsed">
     <TextBlock Text="Recevoir des fichiers" Style="{StaticResource Title}"/>
     <TextBlock Text="Lien de l’expéditeur" Style="{StaticResource Hint}" Margin="0,24,0,6"/>
     <TextBox x:Name="ReceiveUrl" AutomationProperties.Name="Lien Passload reçu" TextChanged="ReceiveUrlChanged"/>
     <Button x:Name="InspectButton" Content="Ouvrir le lien" Style="{StaticResource Primary}" Margin="0,12,0,0" Click="InspectLink"/>
     <Border x:Name="IncomingCard" Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="Collapsed"><StackPanel>
      <DockPanel><Button x:Name="ZipButton" Content="Tout télécharger en ZIP" DockPanel.Dock="Right" Click="DownloadZip"/><TextBlock x:Name="IncomingSummary" Style="{StaticResource SectionTitle}"/></DockPanel>
      <StackPanel x:Name="IncomingRows" Margin="0,10,0,0"/>
     </StackPanel></Border>
     <DockPanel x:Name="DownloadPanel" Visibility="Collapsed" Margin="0,14,0,0"><Button DockPanel.Dock="Right" Content="Annuler" Click="CancelReceive"/>
      <StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock x:Name="DownloadText" Style="{StaticResource Hint}"/><ProgressBar x:Name="DownloadProgress" Height="3" Foreground="{StaticResource Ink}" Margin="0,6,0,0"/></StackPanel>
     </DockPanel>
    </StackPanel>
    <StackPanel x:Name="NetworkPage" Visibility="Collapsed">
     <TextBlock Text="Connexion" Style="{StaticResource Title}"/>
     <TextBlock Text="Pour un lien sur le réseau public, Passload demande une redirection temporaire à la box." Style="{StaticResource Hint}" Margin="0,22,0,0"/>
     <Expander Header="Réglages avancés" Margin="0,18,0,0"><StackPanel Margin="3,12,3,0">
      <TextBlock x:Name="LocalAddressText" Style="{StaticResource Hint}"/><TextBlock x:Name="IPv6Text" Style="{StaticResource Hint}" Margin="0,3,0,8"/>
      <WrapPanel><Button Content="Actualiser" Click="RefreshNetwork" Margin="0,0,6,4"/><Button x:Name="RouterButton" Content="Ouvrir ma box" Click="OpenRouter" Margin="0,0,6,4"/></WrapPanel>
      <Grid Margin="0,10,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="98"/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="Port TCP" Style="{StaticResource Hint}"/><TextBox x:Name="PortInput" Margin="0,4,0,0" AutomationProperties.Name="Port TCP du PC"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="Adresse publique manuelle" Style="{StaticResource Hint}"/><TextBox x:Name="ManualInput" Margin="0,4,0,0" AutomationProperties.Name="Adresse publique manuelle"/></StackPanel>
      </Grid>
      <TextBlock Text="Nom de domaine pour le certificat HTTPS" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
      <TextBox x:Name="PublicHostInput" Margin="0,0,0,10" AutomationProperties.Name="Nom de domaine pour le certificat HTTPS"
       ToolTip="Nom couvert par un certificat valide installé dans Windows. Laissez ce champ vide pour les liens par adresse IP."/>
      <WrapPanel><Button Content="Enregistrer" Click="SaveNetwork" Margin="0,0,6,4"/><Button x:Name="FirewallButton" Content="Autoriser dans le pare-feu" Click="RequestFirewall" Margin="0,0,0,4"/></WrapPanel>
     </StackPanel></Expander>
     <WrapPanel Margin="0,16,0,0">
      <Button x:Name="CheckUpdateButton" Content="Vérifier les mises à jour" Click="CheckUpdate" Margin="0,0,8,4"/>
      <Button Content="Licences du logiciel" Style="{StaticResource TextAction}" Click="ShowLicenses" Margin="0,0,0,4"/>
     </WrapPanel>
    </StackPanel>
   </Grid>
  </ScrollViewer>
  <Border x:Name="NoticeBox" Grid.Row="2" Background="#F3F3F0" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,9" Visibility="Collapsed"><DockPanel>
   <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource TextAction}" ToolTip="Masquer le message" Click="DismissNotice"/>
   <TextBlock x:Name="NoticeText" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="14" AutomationProperties.LiveSetting="Polite"/>
  </DockPanel></Border>
 </Grid>
</Window>
