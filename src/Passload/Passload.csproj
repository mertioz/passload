<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets/Passload.ico</ApplicationIcon>
    <AssemblyName>Passload</AssemblyName>
    <Description>Partage de fichiers temporaire entre ordinateurs.</Description>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <ProjectReference Include="../Passload.Core/Passload.Core.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <Resource Include="Assets/Fonts/*.ttf" />
    <Resource Include="Assets/Passload.ico" />
    <EmbeddedResource Include="../../LICENSE" LogicalName="Passload.LICENSE" />
    <EmbeddedResource Include="../../licenses/*.txt" />
  </ItemGroup>
</Project>
